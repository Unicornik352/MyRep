<Window x:Class="SadovDiploma.Windows.CashierWindows.CashierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SadovDiploma.Windows.CashierWindows"
        mc:Ignorable="d"
                 Title="Старший кассир - список заявок на маркировку товара" MinHeight="600" MinWidth="1000" WindowState="Maximized" Background="#e9f1f2" WindowStartupLocation="CenterScreen" 
        Icon="\price-scan-scanner-bar-barcode-code_108573.ico" >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Выход" x:Name="ButtonExit"  Style="{StaticResource ExitButton}" Click="ButtonExit_Click" VerticalAlignment="Center"  Width="100" Height="30" Margin="0 0 20 0"/>
            <TextBlock Text="Старший кассир: " FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Margin="0,0,20,0" x:Name="TbName" VerticalAlignment="Center"/>
        </StackPanel>


        <DataGrid Grid.Column="0" Grid.Row="1" AutoGenerateColumns="False" x:Name="DataGridApplications" IsReadOnly="True">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Номер" Binding="{Binding id}"  Width="Auto" />
                <DataGridTextColumn Header="Дата создания" Binding="{Binding dateCreation, StringFormat=yyyy-MM-dd HH:mm}" Width="Auto"  />
                <DataGridTextColumn Header="Товар" Binding="{Binding Products.name}"  Width="*" />
                <DataGridTextColumn Header="ЛК" Binding="{Binding Products.id}"  Width="Auto" />
                <DataGridTextColumn Header="Отдел" Binding="{Binding Products.Categories.Departments.name}"  Width="Auto" />
                <DataGridTextColumn Header="Причина" Binding="{Binding ReasonsRequests.name}" Width="Auto" />
                <DataGridTemplateColumn Header="Что сделано" Width="*" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding actionsTaken}" TextWrapping="Wrap" MaxWidth="200" HorizontalAlignment="Left" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Исполнитель" Binding="{Binding executor}" Width="Auto" />
                <DataGridTemplateColumn Header="Описание" Width="*" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding description}" TextWrapping="Wrap" MaxWidth="200" HorizontalAlignment="Left"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Статус" Width="Auto" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusesRequestsMarking.name}" Background="{Binding ColorStatus}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Дата закрытия" Binding="{Binding dateClose, StringFormat=yyyy-MM-dd HH:mm}" Width="Auto"  />

            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <Button Content="Список заявок на списание товара" x:Name="ButtonListRequestsWriteOff" Click="ButtonListRequestsWriteOff_Click" Margin="0,0,10,0" 
                    Padding="10,5" Width="250" Height="25" />
            <Button Content="Добавить" x:Name="ButtonAdd" Click="ButtonAdd_Click" Margin="0,0,10,0" Padding="10,5" Width="100" Height="25"/>
            <Button Content="Удалить" x:Name="ButtonDelete" Click="ButtonDelete_Click"  Padding="10,5"  Width="100" Height="25"/>
        </StackPanel>


        <StackPanel Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Width="220" Margin="10" Background="#F0F0F0">


            <TextBlock Text="Поиск" FontWeight="Bold" Margin="5" />
            <TextBlock Text="Наименование товара:" Margin="5,0,5,0" />
            <TextBox Margin="5,0,5,5" x:Name="SearchNameProduct" TextChanged="SearchNameProduct_TextChanged"/>
            <TextBlock Text="Локальный код:" Margin="5,0,5,0" />
            <TextBox Margin="5,0,5,5" x:Name="SearchLK" TextChanged="SearchLK_TextChanged"/>
            <TextBlock Text="Номер заявки:" Margin="5,0,5,0" />
            <TextBox Margin="5,0,5,5" x:Name="SearchNumberApp" TextChanged="SearchNumberApp_TextChanged"/>
            <TextBlock Text="Исполнитель:" Margin="5,0,5,0"/>
            <TextBox Margin="5,0,5,5" x:Name="SearchExecutor" TextChanged="SearchExecutor_TextChanged"/>

            <TextBlock Text="Фильтр" FontWeight="Bold" Margin="5,10,5,5" />
            <TextBlock Text="Статус заявки:" Margin="5,0,5,0" />
            <ComboBox Margin="5,0,5,5" x:Name="CbFilterStatus" SelectionChanged="CbFilterStatus_SelectionChanged"/>
            <TextBlock Text="Отдел:" Margin="5,0,5,0" />
            <ComboBox Margin="5,0,5,5" x:Name="CbFilterDepartment" SelectionChanged="CbFilterDepartment_SelectionChanged"/>

            <TextBlock Text="Дата создания:" Margin="5,0,5,0" />
            <DatePicker Margin="5,0,5,5" x:Name="FilterDate" SelectedDateChanged="FilterDate_SelectedDateChanged"/>

            <TextBlock Text="Сортировка" FontWeight="Bold" Margin="5,10,5,5" />
            <TextBlock Text="По дате создания:" Margin="5,0,5,0" />
            <ComboBox Margin="5,0,5,5" x:Name="SortDate" SelectionChanged="SortDate_SelectionChanged" >
                <ComboBoxItem Content="Сначала новые"/>
                <ComboBoxItem Content="Сначала старые"/>
            </ComboBox>
            <Button Content="Сбросить" Margin="30 10 30 10" Style="{StaticResource ResetButton}" x:Name="ButtonClear" Click="ButtonClear_Click"/> 
        </StackPanel>
    </Grid>
</Window>
