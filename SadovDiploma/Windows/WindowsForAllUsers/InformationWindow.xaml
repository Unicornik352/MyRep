<Window x:Class="SadovDiploma.Windows.WindowsForAllUsers.InformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SadovDiploma.Windows.WindowsForAllUsers"
        mc:Ignorable="d"
        Title="" Height="160" Width="300" ResizeMode="NoResize" Background="#e9f1f2" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image  Width="50" Height="50" x:Name="MyImage"/>
            <TextBlock x:Name="TbMessage" Grid.Column="1" TextWrapping="Wrap" TextAlignment="Left" Margin="10 0 10 0"/>
        </Grid>
        <Grid Grid.Row="1" Background="#f7f7f7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 5 10 5" >
            <Button Content="ОК" Height="25" Width="50"  Style="{StaticResource BaseButton}" x:Name="ButtonOK" Click="ButtonOK_Click" Visibility="Collapsed" Foreground="Black"/>
            <Button Content="Да" Height="25" Width="50" Margin="10 0 10 0" Style="{StaticResource BaseButton}" Visibility="Collapsed"  x:Name="ButtonYes" Click="ButtonYes_Click"/>
            <Button Content="Нет" Height="25" Width="50" Style="{StaticResource ExitButton}" Visibility="Collapsed"  x:Name="ButtonNo" Click="ButtonNo_Click"/>
            
        </StackPanel>
        </Grid>
    </Grid>
</Window>
