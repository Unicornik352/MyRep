<Window x:Class="SadovDiploma.Windows.WindowsForAllUsers.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SadovDiploma.Windows.WindowsForAllUsers"
        mc:Ignorable="d"
             Title="Авторизация" Height="330" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#e9f1f2" 
        Icon="\price-scan-scanner-bar-barcode-code_108573.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
            <RowDefinition/>

        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Авторизация" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" Margin="0 20 0 0" Foreground="#0087B8"/>
        <TextBox Grid.Row="1"  Width="180" Height="35"  x:Name="TbLogin" Text="Логин" Foreground="Gray"
                 GotFocus="TbLogin_GotFocus" LostFocus="TbLogin_LostFocus" VerticalContentAlignment="Center"
  />
        <TextBox Grid.Row="2"  Width="180" Height="35" x:Name="TbPassword" Text="Пароль" Foreground="Gray"
                 GotFocus="TbPassword_GotFocus" VerticalContentAlignment="Center"
/>
        <PasswordBox x:Name="PbPassword" Width="180" Grid.Row="2" Height="35"  Visibility="Hidden" VerticalContentAlignment="Center"
                     LostFocus="PbPassword_LostFocus"
/>


        <Button Grid.Row="4"  Margin="130 5 130 10" Content="Авторизоваться" x:Name="AuthButton" Click="AuthButton_Click"  />

    </Grid>
</Window>
