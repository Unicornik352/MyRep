<Window x:Class="SadovDiploma.AnalystWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Аналитик - сводки и диаграммы" Height="1000" Width="1300" WindowState="Maximized" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="10">
            <Button Content="Выход" x:Name="ButtonExit"  Style="{StaticResource ExitButton}" Click="ButtonExit_Click" VerticalAlignment="Center"  Width="100" Height="30" Margin="0 0 20 0"/>
            <TextBlock Text="Аналитик: " FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Margin="0,0,20,0" x:Name="TbName" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <ComboBox x:Name="ComboPeriod" Width="150" SelectionChanged="ComboPeriod_SelectionChanged">
                <ComboBoxItem Content="Неделя"/>
                <ComboBoxItem Content="Месяц"/>
                <ComboBoxItem Content="Год"/>
                <ComboBoxItem Content="Свой период" IsSelected="True"/>
            </ComboBox>

            <StackPanel x:Name="DateSelectionPanel" Orientation="Horizontal" Margin="10,0,0,0">
                <DatePicker x:Name="StartDate" Width="120" Margin="5,0"/>
                <DatePicker x:Name="EndDate" Width="120"/>
            </StackPanel>

            <Button Content="Сформировать отчет" Click="BtnGenerate_Click" Margin="15,0" Padding="15,5" Background="#007ACC" Foreground="White"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Сводная информация" Margin="0,0,10,0">
                <TextBox x:Name="TxtReport" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="13"/>
            </GroupBox>

            <ScrollViewer Grid.Column="1">
                <StackPanel x:Name="ChartContainer" Background="White">
                    <TextBlock Text="Диаграмма: Заявки на маркировку (кол-во)" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10"/>
                    <lvc:PieChart x:Name="PieChartMarking" Height="350" LegendLocation="Bottom" Hoverable="True"/>

                    <Separator Margin="0,20"/>

                    <TextBlock Text="Диаграмма: Списания товара (сумма в рублях)" 
           FontSize="16" FontWeight="Bold" 
           HorizontalAlignment="Center" Margin="0,10"/>
                    <lvc:PieChart x:Name="PieChartWriteOff" Height="350" LegendLocation="Bottom" Hoverable="True"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Экспорт отчета (.txt)" Click="BtnExportTxt_Click" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="Экспорт диаграмм (.png)" Click="BtnExportPng_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>