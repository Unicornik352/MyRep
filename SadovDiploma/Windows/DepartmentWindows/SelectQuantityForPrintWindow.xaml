<Window x:Class="SadovDiploma.Windows.DepartmentWindows.SelectQuantityForPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SadovDiploma.Windows.DepartmentWindows"
        mc:Ignorable="d"
              Title="Инициализация печати маркировки" Height="150" Width="300" ResizeMode="NoResize" Background="#e9f1f2" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Укажите количество элементов для печати"/>
                <TextBox  Width="40" Height="35" x:Name="TbQuantity" Text="1" HorizontalContentAlignment="Center" Margin="0 20 0 0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Background="#f7f7f7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 5 10 5" >
                <Button Content="Подтвердить" Height="25" Width="110"  Margin="0 0 10 0" x:Name="ButtonGOPrint" Click="ButtonGOPrint_Click"/>
                <Button Content="Отмена" Height="25" Width="110" Style="{StaticResource ExitButton}"   x:Name="ButtonCancel" Click="ButtonCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>