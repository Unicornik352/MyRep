<Window x:Class="SadovDiploma.Windows.DepartmentWindows.DepartmentEditRequestMarkingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SadovDiploma.Windows.DepartmentWindows"
        mc:Ignorable="d"
                   Title="Торговый отдел - детали заявки" Height="500" Width="800" 
        Background="#e9f1f2" WindowStartupLocation="CenterScreen" Icon="\price-scan-scanner-bar-barcode-code_108573.ico" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="1.3*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Заявка " FontWeight="Bold" Margin="10,10,5,5">
            <Run x:Name="TbNumberReq"/>
        </TextBlock>
        <TextBlock Text="Заявка создана"  Grid.Row="1" FontWeight="Bold" Margin="10,5,5,5" x:Name="TbStatusReq"/>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image  Height="80" Width="90" HorizontalAlignment="Left" Margin="5 0 0 0" x:Name="ImageProduct" MouseLeftButtonDown="ImageProduct_MouseLeftButtonDown"/>
            <Button Content="Печать маркировки" Grid.Column="1" Style="{StaticResource ResetButton}" Height="40" Width="200" HorizontalAlignment="Right"
                    Margin="0 0 10 0" x:Name="PrintMarkingButton" Click="PrintMarkingButton_Click"/>
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование товара:" FontWeight="Bold" Margin="10,5,5,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbNameProduct" Margin="5,5,10,5" IsReadOnly="True"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Локальный код товара:" FontWeight="Bold" Margin="10,5,5,5"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbLK" Margin="5,5,10,5" IsReadOnly="True"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Создатель:" FontWeight="Bold" Margin="10,5,5,5"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TbCreator" Margin="5,5,10,5" IsReadOnly="True"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Причина:*" FontWeight="Bold" Margin="10,5,5,5"/>
        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="CbReason" Margin="5,5,10,5" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Что сделано:*" FontWeight="Bold" Margin="10,5,5,5"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TbActionsTaken" Margin="5,5,10,5"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Исполнитель:*" FontWeight="Bold" Margin="10,5,5,5"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TbExecutor" Margin="5,5,10,5"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Описание:" FontWeight="Bold" Margin="10,5,5,5"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="TbDescription" Margin="5,5,10,5" TextWrapping="Wrap" IsReadOnly="True"/>

   
        <StackPanel Orientation="Horizontal" Grid.Row="12" Grid.ColumnSpan="2" HorizontalAlignment="Center">

            <Button  Width="130" Margin="0 0 10 0" x:Name="ButtonCloseReq" Height="30" Click="ButtonCloseReq_Click"/>
            <Button Content="Назад " Width="130"  x:Name="BackButton"   Margin="10 0 0 0" Height="30" Style="{StaticResource ExitButton}" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
