<Window x:Class="SadovDiploma.Windows.StorekeeperWindows.StorekeeperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SadovDiploma.Windows.StorekeeperWindows"
        mc:Ignorable="d"
                          Title="Кладовщик - список заявок на списание товара" Height="650" Width="1000" Background="#e9f1f2"  WindowStartupLocation="CenterScreen"
        Icon="\price-scan-scanner-bar-barcode-code_108573.ico" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal"  Margin="10" Grid.ColumnSpan="2">
            <Button Content="Выход" x:Name="ExitButton" Click="ButtonExit_Click" Style="{StaticResource ExitButton}" Width="100" Height="30" Margin="20 0 15 0"/>
            <TextBlock Text="Кладовщик" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"  VerticalAlignment="Center" x:Name="TbStorekeeper" TextWrapping="Wrap" Width="350"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="2" Width="200" Margin="10" Background="#F0F0F0">
            <TextBlock Text="Поиск" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="Номер заявки:" Margin="5,0,5,0"/>
            <TextBox Margin="5,0,5,5" x:Name="SearchNumberReq" TextChanged="SearchNumberReq_TextChanged"/>
            <TextBlock Text="Локальный код товара:" Margin="5,0,5,0"/>
            <TextBox Margin="5,0,5,5" x:Name="SearchLK" TextChanged="SearchLK_TextChanged"/>
            <TextBlock Text="Наименование товара:" Margin="5,0,5,0"/>
            <TextBox Margin="5,0,5,5" x:Name="SearchName" TextChanged="SearchName_TextChanged"/>
            <TextBlock Text="Фильтр" FontWeight="Bold" Margin="5,10,5,5"/>
            <TextBlock Text="Статус заявки:" Margin="5,0,5,0"/>
            <ComboBox Margin="5,0,5,5" x:Name="CbFilterStatus" SelectionChanged="FilterStatus_SelectionChanged"/>
            <TextBlock Text="Дата создания:" Margin="5,0,5,0"/>
            <DatePicker Margin="5,0,5,5" x:Name="FilterDate" SelectedDateChanged="FilerData_SelectedDateChanged"/>

            <TextBlock Text="Сортировка" FontWeight="Bold" Margin="5,10,5,5"/>
            <TextBlock Text="Дата создания:" Margin="5,0,5,0"/>
            <ComboBox Margin="5,0,5,5" x:Name="SortDate" SelectionChanged="SortDate_SelectionChanged" >
                <ComboBoxItem Content="Сначала новые"/>
                <ComboBoxItem Content="Сначала старые"/>
            </ComboBox>

            <Button Content="Сбросить" Margin="10" Style="{StaticResource ResetButton}" x:Name="ClearButton" Click="ClearButton_Click" />
            <Button Content="Удалить" Margin="10 30 0 0"  x:Name="DeleteButton" Click="DeleteButton_Click" Visibility="Collapsed"/>
        </StackPanel>

        <ListView x:Name="ListViewRequests" MouseDoubleClick="ListViewRequests_MouseDoubleClick" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1"  Margin="10" Style="{StaticResource MainContainer}">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Заявка " FontWeight="Bold" HorizontalAlignment="Center" Margin="2" FontSize="16">
             <Run Text="{Binding id}"/>
                            </TextBlock>


                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Наименование товара" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Products.name}" Margin="0 0 0 2" FontSize="16"/>
                                    <TextBlock Text="Локальный код товара" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Products.id}" Margin="0 0 0 2" FontSize="16"/>
                                    <TextBlock Text="Статус" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding StatusesRequestsWriteOff.name}" Margin="0 0 0 2" FontSize="16" Width="200" HorizontalAlignment="Left" Background="{Binding ColorStatus}"/>
                                    <TextBlock Text="Сумма списания" FontWeight="Bold" FontSize="16" Visibility="{Binding VisibilitySummWriteOff}"/>
                                    <TextBlock Text="{Binding SummWriteOff}" Margin="0 0 0 2" FontSize="16" Width="200" HorizontalAlignment="Left" />
                                </StackPanel>


                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="Дата создания" FontWeight="Bold" Margin="2 20 2 2" HorizontalAlignment="Right" FontSize="16"/>
                                    <TextBlock Text="{Binding dateCreation, StringFormat=dd.MM.yyyy HH:mm}" Margin="2" HorizontalAlignment="Right" FontSize="16" />
                                    <TextBlock Text="Дата закрытия" FontWeight="Bold" Margin="2 20 2 2" HorizontalAlignment="Right" FontSize="16"/>
                                    <TextBlock Text="{Binding dateClose, StringFormat=dd.MM.yyyy HH:mm}" Margin="2" HorizontalAlignment="Right" FontSize="16" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
